{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rsp-verification-scenario",
  "type": "object",
  "required": ["id", "layer", "owner", "execution_mode", "fixture_refs", "required_evidence", "oracle", "rubric", "artifact_policy"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*$" },
    "layer": { "enum": ["test", "evaluation", "acceptance"] },
    "owner": { "type": "string", "minLength": 1 },
    "execution_mode": { "enum": ["deterministic", "simulated", "local", "fake-provider", "disposable-project", "real-provider"] },
    "fixture_refs": { "type": "array", "items": { "type": "string" } },
    "required_evidence": { "type": "array", "items": { "type": "string" } },
    "oracle": { "type": "string", "minLength": 1 },
    "rubric": { "type": "string", "minLength": 1 },
    "artifact_policy": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
