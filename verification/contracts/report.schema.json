{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rsp-verification-aggregate-report",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "verdict",
    "planned",
    "executed",
    "verified",
    "failed",
    "skipped",
    "unavailable",
    "unverified",
    "simulated",
    "runs",
    "errors",
    "omissions",
    "evidence",
    "usage",
    "ai_analysis",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["passed", "failed", "incomplete", "stopped"] },
    "planned": { "type": "integer", "minimum": 0 },
    "executed": { "type": "integer", "minimum": 0 },
    "verified": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "skipped": { "type": "integer", "minimum": 0 },
    "unavailable": { "type": "integer", "minimum": 0 },
    "unverified": { "type": "integer", "minimum": 0 },
    "simulated": { "type": "integer", "minimum": 0 },
    "runs": { "type": "array" },
    "errors": { "type": "array" },
    "omissions": { "type": "array" },
    "evidence": { "type": "array" },
    "usage": { "type": "object" },
    "ai_analysis": { "type": "object" },
    "boundaries": { "type": "array" },
    "source": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
