{
  "name": "@oevery/rsp",
  "type": "module",
  "version": "1.0.1",
  "description": "RSP (Rules, Spec, Plan) workflow for AI-assisted development",
  "author": "oevery",
  "license": "MIT",
  "homepage": "https://github.com/oevery/rsp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oevery/rsp.git"
  },
  "bugs": "https://github.com/oevery/rsp/issues",
  "keywords": [
    "rsp",
    "rules",
    "spec",
    "plan",
    "ai",
    "coding",
    "workflow"
  ],
  "bin": {
    "rsp": "./dist/cli.mjs"
  },
  "files": [
    "dist/",
    "rules/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "pnpm run build",
