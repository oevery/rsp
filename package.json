{
  "name": "@oevery/rsp",
  "type": "module",
  "version": "2.0.4",
  "description": "RSP (Rules, Specs, Plans) workflow for lightweight AI-assisted change management",
  "author": "oevery",
  "license": "MIT",
  "homepage": "https://github.com/oevery/rsp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oevery/rsp.git"
  },
  "bugs": "https://github.com/oevery/rsp/issues",
  "keywords": [
    "rsp",
    "rules",
    "specs",
    "plans",
    "ai",
    "coding",
    "workflow"
  ],
  "bin": {
    "rsp": "bin/rsp.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "rules/",
    "skills/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "pnpm run build",
    "release:check": "pnpm run build && pnpm run lint && pnpm run test && npm pack --dry-run --ignore-scripts",
    "prepublishOnly": "pnpm run release:check",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^22.19.19",
    "eslint": "^10.4.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.7"
  }
}
