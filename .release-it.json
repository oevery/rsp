{
  "git": {
    "requireBranch": "main",
    "requireUpstream": true,
    "commit": true,
    "commitMessage": "chore(release): v${version}",
    "tag": true,
    "tagName": "v${version}",
    "push": true
  },
  "npm": {
    "publish": false,
    "versionArgs": ["--ignore-scripts"]
  },
  "github": { "release": true, "releaseName": "v${version}" },
  "gitlab": { "release": false },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": { "name": "conventionalcommits" },
      "context": { "host": "https://github.com", "owner": "oevery", "repository": "rsp" },
      "infile": "CHANGELOG.md"
    }
  }
}
